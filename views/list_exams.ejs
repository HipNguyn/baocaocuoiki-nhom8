<%- include('partials/header') %>

<div class="max-w-5xl mx-auto my-10 px-4">
    <div class="flex items-center justify-between mb-8 pb-4 border-b">
        <h1 class="text-3xl font-bold text-slate-800 border-l-4 border-blue-600 pl-4"><%= pageTitle %></h1>
        <a href="/index" class="text-slate-500 hover:text-blue-600 font-medium transition">
            <i class="fa-solid fa-arrow-left mr-1"></i> Quay lại
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (data && data.length > 0) { %>
            <% data.forEach(exam => { %>
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                    <div class="h-2 bg-blue-500 w-full"></div>
                    <div class="p-6">
                        <h2 class="text-xl font-bold text-slate-800 mb-2 line-clamp-2"><%= exam.tieu_de %></h2>
                        <p class="text-slate-500 text-sm mb-5 line-clamp-2"><%= exam.mo_ta %></p>
                        
                        <div class="flex items-center justify-between mt-auto">
                            <span class="inline-flex items-center bg-blue-50 text-blue-700 text-xs font-semibold px-3 py-1 rounded-full">
                                <i class="fa-regular fa-clock mr-1"></i> <%= exam.thoi_gian %> phút
                            </span>
                            
                            <a href="/exam/<%= exam._id %>" class="inline-flex items-center justify-center px-4 py-2 bg-slate-800 text-white text-sm font-semibold rounded-lg hover:bg-slate-900 transition">
                                Làm bài <i class="fa-solid fa-arrow-right ml-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-span-full py-16 bg-slate-50 rounded-2xl border border-dashed border-slate-300 text-center">
                <div class="w-16 h-16 bg-white text-slate-400 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl shadow-sm">
                    <i class="fa-solid fa-folder-open"></i>
                </div>
                <h3 class="text-lg font-bold text-slate-700 mb-1">Chưa có đề thi nào</h3>
                <p class="text-slate-500">Giảng viên chưa cập nhật đề thi cho mục này.</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>