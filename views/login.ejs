<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - Học Tập</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .hidden-form { display: none; }
        .visible-form { display: block; animation: fadeIn 0.4s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
    <script>
        tailwind.config = { theme: { extend: { colors: { 'brand-red': '#c62828', 'brand-gold': '#fbc02d', 'brand-dark': '#1e293b' }}}}
    </script>
</head>
<body class="bg-slate-100 flex items-center justify-center min-h-screen p-4">

<div class="w-full max-w-md bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-200">
    <div class="bg-brand-dark p-6 text-center">
        <h1 class="text-2xl font-bold text-white tracking-wide font-serif"><i class="fa-solid fa-star text-brand-gold mr-2 text-sm"></i>HCM Ideology</h1>
        <p class="text-slate-400 text-sm mt-1">Đăng nhập để vào hệ thống thi</p>
    </div>

    <div class="flex border-b border-slate-200 cursor-pointer">
        <div id="tab-login" onclick="switchTab('login')" class="flex-1 py-4 font-bold text-center text-brand-red border-b-2 border-brand-red transition bg-red-50/50">ĐĂNG NHẬP</div>
        <div id="tab-register" onclick="switchTab('register')" class="flex-1 py-4 font-bold text-center text-slate-400 hover:text-brand-red transition">ĐĂNG KÝ</div>
    </div>

    <div class="p-8">
        <% if (error) { %>
            <div class="mb-4 p-3 bg-red-100 border border-red-200 text-red-700 text-sm rounded-lg flex items-center gap-2">
                <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
            </div>
        <% } %>
        <% if (success) { %>
            <div class="mb-4 p-3 bg-green-100 border border-green-200 text-green-700 text-sm rounded-lg flex items-center gap-2">
                <i class="fa-solid fa-circle-check"></i> <%= success %>
            </div>
        <% } %>

        <form id="form-login" action="/login" method="POST" class="visible-form">
            <div class="mb-4">
                <label class="block text-sm font-bold text-slate-700 mb-2">Email</label>
                <div class="relative">
                    <i class="fa-solid fa-envelope absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                    <input type="email" name="email" required class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-brand-red outline-none transition">
                </div>
            </div>
            <div class="mb-6">
                <label class="block text-sm font-bold text-slate-700 mb-2">Mật khẩu</label>
                <div class="relative">
                    <i class="fa-solid fa-lock absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                    <input type="password" name="password" required class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:border-brand-red outline-none transition">
                </div>
            </div>
            <button type="submit" class="w-full py-3 bg-brand-red text-white font-bold rounded-xl shadow-lg hover:bg-red-700 transition">Đăng nhập</button>
        </form>

        <form id="form-register" action="/register" method="POST" class="hidden-form">
            <div class="mb-4">
                <label class="block text-sm font-bold text-slate-700 mb-2">Họ và Tên</label>
                <div class="relative">
                    <i class="fa-solid fa-user absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                    <input type="text" name="fullname" required class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none transition">
                </div>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-bold text-slate-700 mb-2">Email</label>
                <div class="relative">
                    <i class="fa-solid fa-envelope absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                    <input type="email" name="email" required class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none transition">
                </div>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-bold text-slate-700 mb-2">Mật khẩu</label>
                <div class="relative">
                    <i class="fa-solid fa-lock absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                    <input type="password" name="password" required class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none transition">
                </div>
            </div>
            <div class="mb-6">
                <label class="block text-sm font-bold text-slate-700 mb-2">Nhập lại Mật khẩu</label>
                <div class="relative">
                    <i class="fa-solid fa-lock absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                    <input type="password" name="confirm_password" required class="w-full pl-10 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl outline-none transition">
                </div>
            </div>
            <button type="submit" class="w-full py-3 bg-brand-dark text-white font-bold rounded-xl shadow-lg hover:bg-slate-800 transition">Đăng ký tài khoản</button>
        </form>
    </div>
</div>

<script>
    function switchTab(tab) {
        const formLogin = document.getElementById('form-login');
        const formRegister = document.getElementById('form-register');
        const tabLogin = document.getElementById('tab-login');
        const tabRegister = document.getElementById('tab-register');

        if (tab === 'login') {
            formLogin.classList.replace('hidden-form', 'visible-form');
            formRegister.classList.replace('visible-form', 'hidden-form');
            tabLogin.className = 'flex-1 py-4 font-bold text-center text-brand-red border-b-2 border-brand-red transition bg-red-50/50';
            tabRegister.className = 'flex-1 py-4 font-bold text-center text-slate-400 hover:text-brand-red transition';
        } else {
            formRegister.classList.replace('hidden-form', 'visible-form');
            formLogin.classList.replace('visible-form', 'hidden-form');
            tabRegister.className = 'flex-1 py-4 font-bold text-center text-brand-red border-b-2 border-brand-red transition bg-red-50/50';
            tabLogin.className = 'flex-1 py-4 font-bold text-center text-slate-400 hover:text-brand-red transition';
        }
    }
</script>
</body>
</html>