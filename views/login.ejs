<%- include('partials/header') %>

<div class="min-h-screen flex items-center justify-center bg-slate-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-white p-8 rounded-2xl shadow-xl border border-slate-100">
        <div class="text-center mb-8">
            <div class="mx-auto h-14 w-14 bg-blue-600 text-white rounded-full flex items-center justify-center text-2xl mb-4 shadow-lg">
                <i class="fa-solid fa-right-to-bracket"></i>
            </div>
            <h2 class="text-3xl font-extrabold text-slate-800">Đăng nhập hệ thống</h2>
            <p class="mt-2 text-sm text-slate-500">Chào mừng bạn quay lại ôn thi</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-r-lg" role="alert">
                <p class="text-sm font-semibold"><%= error %></p>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="bg-emerald-50 border-l-4 border-emerald-500 text-emerald-700 p-4 mb-6 rounded-r-lg" role="alert">
                <p class="text-sm font-semibold"><%= success %></p>
            </div>
        <% } %>

        <form class="space-y-5" action="/login" method="POST">
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-1">Email</label>
                <input type="email" name="email" required placeholder="vidu@gmail.com" 
                       class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition outline-none text-slate-700">
            </div>

            <div>
                <label class="block text-sm font-bold text-slate-700 mb-1">Mật khẩu</label>
                <input type="password" name="password" required placeholder="Nhập mật khẩu" 
                       class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition outline-none text-slate-700">
            </div>

            <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-md text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-200">
                Đăng nhập
            </button>
        </form>

        <div class="mt-6 text-center text-sm text-slate-500 font-medium">
            Chưa có tài khoản? 
            <a href="/register" class="text-red-600 hover:text-red-500 font-bold hover:underline transition">
                Đăng ký ngay
            </a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>