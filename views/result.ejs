<%- include('partials/header') %>

<div class="max-w-4xl mx-auto px-4 py-8 min-h-screen">
    
    <div class="mb-6">
        <a href="/index" class="text-slate-500 hover:text-blue-600 font-semibold transition flex items-center gap-2 w-fit">
            <i class="fa-solid fa-arrow-left"></i> Về trang chủ
        </a>
    </div>

    <div class="bg-white rounded-3xl shadow-xl overflow-hidden mb-10 border border-slate-100">
        <div class="px-8 py-10 text-center <%= history.diem_so >= 5 ? 'bg-gradient-to-br from-emerald-500 to-teal-600' : 'bg-gradient-to-br from-red-500 to-rose-600' %> text-white relative">
            <i class="fa-solid <%= history.diem_so >= 5 ? 'fa-award' : 'fa-circle-exclamation' %> absolute text-9xl opacity-20 -right-4 -bottom-4"></i>
            
            <h1 class="text-3xl md:text-4xl font-extrabold mb-2 relative z-10">Kết Quả Bài Thi</h1>
            <p class="text-lg opacity-90 font-medium relative z-10 mb-8"><%= history.ten_bai_thi %></p>
            
            <div class="inline-block bg-white/20 backdrop-blur-md border border-white/30 rounded-3xl px-12 py-8 relative z-10 shadow-lg">
                <div class="text-sm uppercase tracking-widest font-bold mb-2 opacity-90">Điểm số của bạn</div>
                <div class="text-7xl font-black drop-shadow-md">
                    <%= history.diem_so %> <span class="text-3xl text-white/70 font-bold">/ 10</span>
                </div>
            </div>
        </div>
        
        <div class="px-8 py-6 bg-slate-50 flex justify-between items-center text-slate-600 font-medium">
            <div>
                <i class="fa-solid fa-calendar-check mr-2"></i> Ngày thi: <%= new Date(history.createdAt).toLocaleString('vi-VN') %>
            </div>
            <div>
                <span class="px-3 py-1 rounded-full text-sm font-bold <%= history.diem_so >= 5 ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                    <%= history.diem_so >= 5 ? 'ĐẠT YÊU CẦU' : 'CHƯA ĐẠT' %>
                </span>
            </div>
        </div>
    </div>

    <div>
        <h2 class="text-2xl font-bold text-slate-800 mb-6 flex items-center gap-3">
            <i class="fa-solid fa-list-check text-blue-600"></i> Xem lại chi tiết bài làm
        </h2>

        <div class="space-y-6">
            <% history.chi_tiet.forEach((item, index) => { %>
                <% const q = item.cau_hoi_id; %>
                <% const isCorrect = item.dung_sai; %>
                
                <div class="bg-white p-6 rounded-2xl shadow-sm border-2 <%= isCorrect ? 'border-emerald-200' : 'border-red-200' %> relative overflow-hidden">
                    
                    <div class="absolute left-0 top-0 bottom-0 w-2 <%= isCorrect ? 'bg-emerald-500' : 'bg-red-500' %>"></div>

                    <div class="pl-4">
                        <h3 class="font-bold text-lg text-slate-800 mb-4 flex items-start gap-2">
                            <span class="<%= isCorrect ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %> px-2 py-1 rounded text-sm whitespace-nowrap">
                                Câu <%= index + 1 %>
                            </span>
                            <span><%= q ? q.cauHoi : 'Câu hỏi đã bị xóa khỏi hệ thống' %></span>
                        </h3>

                        <% if (q) { %>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4 pl-12 text-sm">
                                <div class="p-3 border rounded-xl flex items-start gap-2 
                                    <%= q.dapAn === 'A' ? 'bg-emerald-50 border-emerald-300 text-emerald-800 font-semibold' : 
                                       (item.cau_tra_loi === 'A' && !isCorrect ? 'bg-red-50 border-red-300 text-red-800' : 'bg-slate-50 border-slate-200 text-slate-600') %>">
                                    <span class="font-bold">A.</span> <%= q.cauA %>
                                </div>
                                <div class="p-3 border rounded-xl flex items-start gap-2 
                                    <%= q.dapAn === 'B' ? 'bg-emerald-50 border-emerald-300 text-emerald-800 font-semibold' : 
                                       (item.cau_tra_loi === 'B' && !isCorrect ? 'bg-red-50 border-red-300 text-red-800' : 'bg-slate-50 border-slate-200 text-slate-600') %>">
                                    <span class="font-bold">B.</span> <%= q.cauB %>
                                </div>
                                <div class="p-3 border rounded-xl flex items-start gap-2 
                                    <%= q.dapAn === 'C' ? 'bg-emerald-50 border-emerald-300 text-emerald-800 font-semibold' : 
                                       (item.cau_tra_loi === 'C' && !isCorrect ? 'bg-red-50 border-red-300 text-red-800' : 'bg-slate-50 border-slate-200 text-slate-600') %>">
                                    <span class="font-bold">C.</span> <%= q.cauC %>
                                </div>
                                <div class="p-3 border rounded-xl flex items-start gap-2 
                                    <%= q.dapAn === 'D' ? 'bg-emerald-50 border-emerald-300 text-emerald-800 font-semibold' : 
                                       (item.cau_tra_loi === 'D' && !isCorrect ? 'bg-red-50 border-red-300 text-red-800' : 'bg-slate-50 border-slate-200 text-slate-600') %>">
                                    <span class="font-bold">D.</span> <%= q.cauD %>
                                </div>
                            </div>

                            <div class="pl-12 flex items-center gap-2 mt-4 font-medium">
                                Lựa chọn của bạn: 
                                <% if (!item.cau_tra_loi) { %>
                                    <span class="text-slate-500 bg-slate-100 px-2 py-1 rounded text-sm">Chưa trả lời</span>
                                <% } else { %>
                                    <span class="px-2 py-1 rounded text-sm text-white font-bold <%= isCorrect ? 'bg-emerald-500' : 'bg-red-500' %>">
                                        Đáp án <%= item.cau_tra_loi %>
                                        <i class="fa-solid <%= isCorrect ? 'fa-check' : 'fa-xmark' %> ml-1"></i>
                                    </span>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</div>

<%- include('partials/footer') %>