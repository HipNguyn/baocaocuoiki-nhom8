<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hệ thống ôn thi trắc nghiệm TTHCM</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: #f8fafc; 
        }
    </style>
</head>
<body class="flex flex-col min-h-screen">
    <nav class="bg-white shadow-sm border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                
                <div class="flex items-center">
                    <a href="/index" class="flex items-center gap-2 text-xl font-bold text-blue-700 hover:text-blue-800 transition">
                        <i class="fa-solid fa-graduation-cap text-2xl"></i>
                        <span>Ôn Thi TTHCM</span>
                    </a>
                    
                    <div class="hidden md:flex ml-10 space-x-2">
                        <a href="/index" class="text-slate-600 hover:bg-blue-50 hover:text-blue-600 px-4 py-2 rounded-lg font-medium transition">
                            <i class="fa-solid fa-house mr-1"></i> Trang chủ
                        </a>
                        <a href="/list_exams?type=thi_thu" class="text-slate-600 hover:bg-blue-50 hover:text-blue-600 px-4 py-2 rounded-lg font-medium transition">
                            <i class="fa-solid fa-file-lines mr-1"></i> Đề thi thử
                        </a>
                    </div>
                </div>
                
                <div class="flex items-center space-x-3">
                    <% if (typeof session !== 'undefined' && session.userId) { %>
                        <% if (session.role === 'admin') { %>
                            <a href="/admin" class="text-slate-500 hover:text-slate-800 font-medium px-3 py-2 transition">
                                <i class="fa-solid fa-gear"></i> Quản trị
                            </a>
                        <% } %>
                        
                        <a href="/profile" class="flex items-center gap-2 text-slate-700 hover:text-blue-600 font-medium px-4 py-2 bg-slate-50 hover:bg-blue-50 rounded-lg border border-slate-200 transition shadow-sm">
                            <i class="fa-solid fa-circle-user text-xl text-blue-500"></i>
                            <span>Hồ sơ cá nhân</span>
                        </a>
                        
                        <a href="/logout" class="text-red-500 hover:bg-red-50 hover:text-red-600 font-medium px-3 py-2 rounded-lg transition" title="Đăng xuất">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </a>
                    <% } else { %>
                        <a href="/login" class="text-slate-600 hover:text-blue-600 font-medium px-4 py-2 transition">Đăng nhập</a>
                        <a href="/register" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-5 py-2 rounded-lg transition shadow-sm">Đăng ký</a>
                    <% } %>
                </div>
                
            </div>
        </div>
    </nav>
    <main class="flex-grow">