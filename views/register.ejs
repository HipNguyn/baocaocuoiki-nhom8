<%- include('partials/header') %>

<div class="min-h-screen flex items-center justify-center bg-slate-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-white p-8 rounded-2xl shadow-xl border border-slate-100">
        <div class="text-center mb-8">
            <div class="mx-auto h-14 w-14 bg-red-600 text-white rounded-full flex items-center justify-center text-2xl mb-4 shadow-lg">
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <h2 class="text-3xl font-extrabold text-slate-800">Tạo tài khoản mới</h2>
            <p class="mt-2 text-sm text-slate-500">Tham gia hệ thống ôn thi Tư tưởng Hồ Chí Minh</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="bg-red-50 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-r-lg" role="alert">
                <p class="font-bold">Đăng ký thất bại!</p>
                <p class="text-sm"><%= error %></p>
            </div>
        <% } %>

        <form class="space-y-5" action="/register" method="POST">
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-1">Họ và tên</label>
                <input type="text" name="ho_va_ten" required placeholder="Nhập họ và tên của bạn" 
                       class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 transition outline-none text-slate-700">
            </div>

            <div>
                <label class="block text-sm font-bold text-slate-700 mb-1">Email</label>
                <input type="email" name="email" required placeholder="vidu@gmail.com" 
                       class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 transition outline-none text-slate-700">
            </div>

            <div>
                <label class="block text-sm font-bold text-slate-700 mb-1">Mật khẩu</label>
                <input type="password" name="mat_khau" required placeholder="Tạo mật khẩu" 
                       class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 transition outline-none text-slate-700">
            </div>

            <div>
                <label class="block text-sm font-bold text-slate-700 mb-1">Xác nhận mật khẩu</label>
                <input type="password" name="xac_nhan_mat_khau" required placeholder="Nhập lại mật khẩu" 
                       class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 transition outline-none text-slate-700">
            </div>

            <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-md text-sm font-bold text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition duration-200">
                Đăng ký tài khoản
            </button>
        </form>

        <div class="mt-6 text-center text-sm text-slate-500 font-medium">
            Đã có tài khoản? 
            <a href="/login" class="text-blue-600 hover:text-blue-500 font-bold hover:underline transition">
                Đăng nhập ngay
            </a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>