<%- include('partials/header') %>

<div class="max-w-4xl mx-auto px-4 py-8 min-h-screen">
    <div class="mb-8 border-b pb-4 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-slate-800 flex items-center gap-3">
                <i class="fa-solid fa-book-open-reader text-blue-600"></i> Ôn tập Lý thuyết
            </h1>
            <p class="text-slate-500 mt-2 font-medium">Bạn đang ôn tập các câu hỏi thuộc <span class="text-blue-600 font-bold">Chương <%= chuongId %></span></p>
        </div>
        <a href="/index" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-lg transition">
            <i class="fa-solid fa-arrow-left mr-1"></i> Quay lại
        </a>
    </div>

    <div class="space-y-6">
        <% if (questions && questions.length > 0) { %>
            <% questions.forEach((q, index) => { %>
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 hover:shadow-md transition">
                    <h3 class="font-bold text-lg text-slate-800 mb-4 flex items-start gap-2">
                        <span class="bg-blue-100 text-blue-700 px-2 py-1 rounded text-sm whitespace-nowrap">Câu <%= index + 1 %></span>
                        <span><%= q.cauHoi %></span>
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4 pl-12">
                        <div class="p-3 bg-slate-50 border border-slate-100 rounded-xl text-slate-700"><span class="font-bold mr-2">A.</span><%= q.cauA %></div>
                        <div class="p-3 bg-slate-50 border border-slate-100 rounded-xl text-slate-700"><span class="font-bold mr-2">B.</span><%= q.cauB %></div>
                        <div class="p-3 bg-slate-50 border border-slate-100 rounded-xl text-slate-700"><span class="font-bold mr-2">C.</span><%= q.cauC %></div>
                        <div class="p-3 bg-slate-50 border border-slate-100 rounded-xl text-slate-700"><span class="font-bold mr-2">D.</span><%= q.cauD %></div>
                    </div>

                    <div class="pl-12">
                        <button onclick="toggleAnswer('<%= q._id %>')" class="text-emerald-600 font-semibold hover:text-emerald-800 transition text-sm flex items-center gap-1">
                            <i class="fa-solid fa-eye"></i> Xem đáp án
                        </button>
                        <div id="dapan-<%= q._id %>" class="hidden mt-3 p-3 bg-emerald-50 border border-emerald-100 text-emerald-800 rounded-lg font-medium">
                            ĐÁP ÁN ĐÚNG: <%= q.dapAn %>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="text-center py-16 bg-white rounded-2xl border border-dashed border-slate-300">
                <img src="https://cdn-icons-png.flaticon.com/512/7486/7486831.png" class="w-24 h-24 mx-auto mb-4 opacity-50" alt="Empty">
                <h3 class="text-xl font-bold text-slate-600 mb-2">Chưa có dữ liệu</h3>
                <p class="text-slate-500">Giảng viên chưa thêm câu hỏi nào cho Chương <%= chuongId %>.</p>
            </div>
        <% } %>
    </div>
</div>

<script>
    function toggleAnswer(id) {
        const dapanDiv = document.getElementById('dapan-' + id);
        if (dapanDiv.classList.contains('hidden')) {
            dapanDiv.classList.remove('hidden');
        } else {
            dapanDiv.classList.add('hidden');
        }
    }
</script>

<%- include('partials/footer') %>